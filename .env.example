# Copy to `.env` (or just `export` these) and fill in ONE provider's key.
# The engine reads whichever key matches the --provider you pick.

# Best free tier, fastest for the live tree demo (recommended default).
# Get a free key (no card) at https://console.groq.com/keys
GROQ_API_KEY=

# Largest free daily quota. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional paid provider.
OPENAI_API_KEY=

# No key needed for:
#   --provider mock    (fully offline, deterministic — used by the tests)
#   --provider ollama  (local; run `ollama serve` first)
